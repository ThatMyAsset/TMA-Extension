{
  "manifest_version": 3,
  "name": "ThatMyAssets Browser DLP",
  "version": "0.1.2",
  "description": "Inspects prompts and UTF-8 text files on supported AI web routes with a native endpoint agent.",
  "permissions": ["nativeMessaging", "storage", "alarms", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://grok.com/*", "https://x.com/*"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "thatmyassets-dlp@thatmyassets.com", "strict_min_version": "128.0" } },
  "action": { "default_title": "ThatMyAssets browser protection status", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://grok.com/*", "https://x.com/*"], "js": ["main-world.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*", "https://grok.com/*", "https://x.com/*"], "js": ["content.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": false }
  ]
}
